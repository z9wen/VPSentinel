# Copy to .env for manual setup. scripts/install-server.sh generates random
# values automatically when .env does not exist.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
VPSENTINEL_AGENT_TOKEN=replace-with-at-least-32-random-characters
VPSENTINEL_NODE_ID=primary-monitor
VPSENTINEL_ADMIN_EMAIL=admin@example.com
VPSENTINEL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
VPSENTINEL_JWT_SECRET=replace-with-at-least-32-random-characters
VPSENTINEL_GRAFANA_WEBHOOK_SECRET=replace-with-at-least-16-random-characters
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
VPSENTINEL_HTTP_PORT=8080
VPSENTINEL_WEB_ORIGIN=http://localhost:8080
VPSENTINEL_COOKIE_SECURE=false
VPSENTINEL_RETENTION_DAYS=30
