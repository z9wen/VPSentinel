# Install as /etc/vpsentinel/agent.env with owner root:vpsentinel and mode 0640.
VPSENTINEL_SERVER_URL=https://monitor.example.com/api/v1/agent/metrics
VPSENTINEL_TOKEN=replace-with-the-one-time-node-token
VPSENTINEL_INTERVAL=15s
VPSENTINEL_REQUEST_TIMEOUT=10s
VPSENTINEL_QUEUE_CAPACITY=120
VPSENTINEL_DISK_PATH=/
