[Unit]
Description=VPSentinel host monitoring agent
Documentation=https://github.com/z9wen/VPSentinel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vpsentinel
Group=vpsentinel
EnvironmentFile=/etc/vpsentinel/agent.env
ExecStart=/usr/local/bin/vpsentinel-agent
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s

# The agent only reads host metrics and initiates outbound HTTPS requests.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
